<%- include('../includes/head.ejs') %>
</head>

<body>
    <%- include('../includes/navigation.ejs') %>
    <main>
        <% if (orders.length <= 0) { %>
            <h1>No orders yet!</h1>
        <% } else { %>
            <% orders.forEach(order => { %>
                <li>
                    <h1># <%= order.id %></h1>
                    <ul>
                        <% order.products.forEach(orderProduct => { %>
                            <li><%= orderProduct.title %> (<%= orderProduct.orderItems.quantity %>)</li>
                        <% }) %>
                    </ul>
                </li>
            <% }) %>
        <% } %>
    </main>
<%- include('../includes/end.ejs') %>
